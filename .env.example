# Local mode is the default. The app reads process environment variables;
# this file is documentation, not loaded automatically.
LEAKLENS_STORAGE=local
# AWS deployment sets these using the EC2 instance role; no static keys needed.
# LEAKLENS_STORAGE=aws
# AWS_REGION=ap-south-1
# LEAKLENS_BUCKET=your-stack-data-bucket
# LEAKLENS_TABLE=your-stack-records-table
# Optional email notifications (off until enabled on the Notifications page).
# Verify BOTH addresses as SES email identities in this region for sandbox demos.
# Use an AWS profile locally or an instance role on EC2, never put credentials in the frontend.
# LEAKLENS_EMAIL_FROM=verified-sender@example.com
# LEAKLENS_EMAIL_TO=verified-recipient@example.com
# LEAKLENS_PUBLIC_URL=https://your-leaklens-host.example
